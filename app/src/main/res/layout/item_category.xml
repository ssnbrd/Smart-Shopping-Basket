<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/sbCard"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/categoryImage"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="?attr/sbBackground"
            android:contentDescription="@string/category_image_description"
            android:scaleType="centerCrop"
            tools:src="@drawable/cat_dairy" />

        <TextView
            android:id="@+id/categoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:minLines="2"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:textColor="?attr/sbTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Молочные продукты" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
